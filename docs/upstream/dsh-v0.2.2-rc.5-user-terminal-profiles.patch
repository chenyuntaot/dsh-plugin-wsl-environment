@@ -0,0 +1,65 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import type { TerminalShell, WebTerminalId, WebTerminalInfo } from '../../src/types.ts'
+import {
+  explicitShellSelection, launchShellChoices, rememberableNativeShellPath, shellChoiceId, terminalLaunchSelection,
+} from '../../src/client/launch-shells.ts'
+
+const cmd: TerminalShell = { path: 'C:\\Windows\\System32\\cmd.exe', name: 'cmd.exe', args: [] }
+const powershell: TerminalShell = { path: 'C:\\Windows\\PowerShell.exe', name: 'powershell', args: ['-NoLogo'] }
+const ubuntuProfileId = 'example.ubuntu'
+const ubuntu: TerminalShell = {
+  path: 'C:\\Windows\\System32\\wsl.exe', name: 'WSL · Ubuntu', args: ['--distribution', 'Ubuntu'],
+  profileId: ubuntuProfileId, sessionDefault: true,
+}
+const debian: TerminalShell = {
+  path: ubuntu.path, name: 'WSL · Debian', args: ['--distribution', 'Debian'], profileId: 'example.debian',
+}
+
+function created(shell: TerminalShell, fields: Partial<WebTerminalInfo> = {}): WebTerminalInfo {
+  return {
+    id: 'terminal' as WebTerminalId, title: shell.name, shell, cwd: 'C:\\Demo', cols: 80, rows: 24,
+    state: 'running', exitCode: null, origin: 'user', control: 'user', ...fields,
+  }
+}
+
+test('legacy Sessions keep the remembered native shell or the first native fallback', () => {
+  assert.equal(launchShellChoices([cmd, powershell], powershell.path).selectedShell, powershell.path)
+  assert.equal(launchShellChoices([cmd, powershell], 'not-present').selectedShell, cmd.path)
+  assert.equal(launchShellChoices([debian, cmd, powershell], debian.path).selectedShell, cmd.path)
+  assert.equal(launchShellChoices([], null).selectedShell, undefined)
+})
+
+test('an unavailable Session default stays selected without removing the native choices', () => {
+  const unavailable = { ...ubuntu, path: '', args: [], unavailableReason: 'Distribution unavailable' }
+  const shells = [cmd, powershell, unavailable]
+  assert.deepEqual(launchShellChoices(shells, powershell.path), {
+    shells, selectedShell: shellChoiceId(unavailable),
+  })
+})
+
+test('profiles sharing an executable remain distinct and transmit no browser launch arguments', () => {
+  assert.notEqual(shellChoiceId(ubuntu), shellChoiceId(debian))
+  assert.deepEqual(explicitShellSelection(ubuntu), { profileId: 'example.ubuntu' })
+  assert.deepEqual(explicitShellSelection(debian), { profileId: 'example.debian' })
+  assert.deepEqual(explicitShellSelection(cmd), { shellPath: cmd.path })
+})
+
+test('opening the card or shortcut sends only a remembered hint, never an explicit override', () => {
+  assert.deepEqual(terminalLaunchSelection(undefined, undefined, cmd.path), { preferredShellPath: cmd.path })
+  assert.deepEqual(terminalLaunchSelection(undefined, undefined, null), {})
+  assert.deepEqual(terminalLaunchSelection(powershell.path, undefined, cmd.path), { shellPath: powershell.path })
+  assert.deepEqual(terminalLaunchSelection(undefined, ubuntuProfileId, cmd.path), { profileId: ubuntuProfileId })
+})
+
+test('only a successful explicit native choice with the matching Host acknowledgement may be remembered', () => {
+  const native = { shellPath: cmd.path }
+  const ack = created(cmd, { rememberShellPath: cmd.path })
+  assert.equal(rememberableNativeShellPath(ack, native), cmd.path)
+  assert.equal(rememberableNativeShellPath(created(cmd), native), undefined)
+  assert.equal(rememberableNativeShellPath(ack, { preferredShellPath: cmd.path }), undefined)
+  assert.equal(rememberableNativeShellPath(ack, { profileId: ubuntuProfileId }), undefined)
+  assert.equal(rememberableNativeShellPath(ack, { shellPath: powershell.path }), undefined)
+  assert.equal(rememberableNativeShellPath(created(ubuntu, { rememberShellPath: ubuntu.path }), { shellPath: ubuntu.path }), undefined)
+  assert.equal(rememberableNativeShellPath({ ...ack, origin: 'agent' }, native), undefined)
+})
