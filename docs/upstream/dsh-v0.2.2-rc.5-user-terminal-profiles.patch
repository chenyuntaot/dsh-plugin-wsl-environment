@@ -0,0 +1,46 @@
+/** Presentation and request selection for the native terminal's shell picker. */
+import type { TerminalCreateRequest, TerminalShell, WebTerminalInfo } from '../types.ts'
+
+/** Host-discovered shell menu, with the Session default taking precedence over browser preference. */
+export interface TerminalLaunchShells {
+  readonly shells: readonly TerminalShell[]
+  readonly selectedShell: string | undefined
+}
+
+/** A contributed profile may share its executable with other choices. */
+export function shellChoiceId(shell: TerminalShell): string {
+  return shell.profileId === undefined ? shell.path : `profile:${shell.profileId}`
+}
+
+/** Project the Host's Session default, even if launching it would currently fail. */
+export function launchShellChoices(shells: readonly TerminalShell[], remembered: string | null): TerminalLaunchShells {
+  const selected = shells.find(shell => shell.sessionDefault === true)
+    ?? shells.find(shell => shell.profileId === undefined && shell.path === remembered)
+    ?? shells.find(shell => shell.profileId === undefined)
+  return { shells, selectedShell: selected === undefined ? undefined : shellChoiceId(selected) }
+}
+
+/** Only the Host may resolve a profile ID to an executable and argument vector. */
+export type TerminalShellSelection = { readonly shellPath: string } | { readonly profileId: string }
+
+export function explicitShellSelection(shell: TerminalShell): TerminalShellSelection {
+  return shell.profileId === undefined ? { shellPath: shell.path } : { profileId: shell.profileId }
+}
+
+export type TerminalLaunchSelection = Pick<TerminalCreateRequest, 'shellPath' | 'profileId' | 'preferredShellPath'>
+
+/** An implicit open carries the remembered native path as a hint, never as an explicit override. */
+export function terminalLaunchSelection(
+  shellPath: string | undefined, profileId: string | undefined, remembered: string | null,
+): TerminalLaunchSelection {
+  if (profileId !== undefined) return { profileId }
+  if (shellPath !== undefined) return { shellPath }
+  return remembered === null ? {} : { preferredShellPath: remembered }
+}
+
+/** Commit preference only when the Host acknowledged the exact explicit native choice. */
+export function rememberableNativeShellPath(info: WebTerminalInfo, selection: TerminalLaunchSelection): string | undefined {
+  const path = selection.shellPath
+  if (path !== undefined && selection.profileId === undefined && info.origin === 'user'
+    && info.shell.profileId === undefined && info.shell.path === path && info.rememberShellPath === path) return path
+}
