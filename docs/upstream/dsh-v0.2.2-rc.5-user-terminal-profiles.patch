diff --git a/packages/api/terminal-controller/tests/host/user-profiles.test.ts b/packages/api/terminal-controller/tests/host/user-profiles.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..09c761431430a732686b331fe1b83afb059f0b9b
--- /dev/null
+++ b/packages/api/terminal-controller/tests/host/user-profiles.test.ts
@@ -0,0 +1,153 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { test } from 'node:test'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SubprocessRuntime } from '@deepseek-ai/dsh-subprocess'
+import { discoverShells, findShell, resolveShell } from '../../src/shells.ts'
+import { selectNativeUserShell, UserTerminalProfileUnavailableError, UserTerminalProfiles, userTerminalChoice } from '../../src/user-profiles.ts'
+import type { UserTerminalProfile } from '../../src/user-profiles.ts'
+
+const wsl = {} as Agent
+const windows = {} as Agent
+const signal = new AbortController().signal
+const awaitThen = <T>(value: T): Promise<T> => Promise.resolve(value)
+const nativePath = String.raw`C:\Windows\System32\cmd.exe`
+const wslPath = String.raw`C:\Windows\System32\wsl.exe`
+const profileId = 'dsh-wsl-env.wsl'
+const nativeShell = { path: nativePath, name: 'cmd.exe', args: [] }
+const profile = {
+  id: profileId, name: 'WSL · Ubuntu', preferred: true,
+  launch: { path: wslPath, args: ['--distribution', 'Ubuntu', '--cd', '/home/test/project'],
+    hostCwd: String.raw`C:\Windows\System32`, displayCwd: '/home/test/project' },
+} satisfies UserTerminalProfile
+const verify = { resolveExecutable: async (path: string) => path }
+
+function absent(): never {
+  throw Object.assign(new Error('missing executable'), { name: 'SubprocessExecutableNotFoundError' })
+}
+
+test('profiles and defaults are scoped to the exact Session Agent at discovery and launch', async () => {
+  const registry = new UserTerminalProfiles()
+  let active = wsl
+  const calls: string[] = []
+  const subprocess = { resolveExecutable: async (path: string) => { calls.push(path); return wslPath } }
+  registry.register('dsh-wsl-env', agent => agent === active ? [profile] : [])
+  assert.deepEqual(await registry.shells(windows, subprocess, signal), [])
+  const choices = await registry.shells(wsl, subprocess, signal)
+  assert.deepEqual(choices.map(choice => [choice.profileId, choice.sessionDefault]), [[profileId, true]])
+  const preference = userTerminalChoice({ preferredShellPath: nativePath })
+  const launch = await registry.launch(wsl, preference, subprocess, signal)
+  assert.equal(launch?.shell.path, wslPath)
+  assert.deepEqual(launch?.shell.args, profile.launch.args)
+  assert.equal(launch?.hostCwd, profile.launch.hostCwd)
+  assert.equal(launch?.displayCwd, profile.launch.displayCwd)
+  assert.equal(await registry.launch(windows, preference, subprocess, signal), undefined)
+  await assert.rejects(registry.launch(windows, userTerminalChoice({ profileId }), subprocess, signal), UserTerminalProfileUnavailableError)
+  active = windows
+  await assert.rejects(registry.launch(wsl, userTerminalChoice({ profileId }), subprocess, signal), UserTerminalProfileUnavailableError)
+  assert.deepEqual(calls, [wslPath, wslPath], 'changed sessions never reused the old catalog or executable')
+})
+
+test('unavailable defaults stay selected and fail closed without starting a remembered native shell', async () => {
+  const registry = new UserTerminalProfiles()
+  registry.register('dsh-wsl-env', () => [{ id: profileId, name: 'WSL', preferred: true, unavailableReason: 'Distribution is unavailable' }])
+  assert.deepEqual(await registry.shells(wsl, verify, signal), [
+    { name: 'WSL', profileId, sessionDefault: true, path: '', args: [], unavailableReason: 'Distribution is unavailable' },
+  ])
+  const choice = userTerminalChoice({ preferredShellPath: nativePath })
+  let triedNative = false
+  await assert.rejects(async () => {
+    const found = await registry.launch(wsl, choice, verify, signal)
+    if (found === undefined) triedNative = true
+  }, { name: 'UserTerminalProfileUnavailableError', message: 'Distribution is unavailable', profileId })
+  await assert.rejects(registry.launch(wsl, userTerminalChoice({ profileId }), verify, signal), UserTerminalProfileUnavailableError)
+  assert.equal(triedNative, false)
+  assert.equal(await registry.mayRememberNativeShell(wsl, signal), false)
+})
+
+test('execution provider verifies a configured profile again after discovery', async () => {
+  const registry = new UserTerminalProfiles()
+  registry.register('dsh-wsl-env', () => [profile])
+  assert.equal((await registry.shells(wsl, verify, signal))[0]?.path, wslPath)
+  const gone = { resolveExecutable: async () => absent() }
+  const [disabled] = await registry.shells(wsl, gone, signal)
+  assert.equal(disabled?.sessionDefault, true)
+  assert.equal(disabled?.path, '')
+  assert.ok(disabled?.unavailableReason)
+  await assert.rejects(registry.launch(wsl, userTerminalChoice({}), gone, signal), UserTerminalProfileUnavailableError)
+})
+
+test('explicit Windows choices stay native, with a fail-safe preference acknowledgement', async () => {
+  const registry = new UserTerminalProfiles()
+  const choice = userTerminalChoice({ shellPath: nativePath })
+  assert.equal(choice.kind, 'native')
+  if (choice.kind !== 'native') throw new Error('Expected native choice')
+  let resolveCalls = 0
+  const dispose = registry.register('dsh-wsl-env', agent => {
+    resolveCalls++
+    if (agent === wsl) return [profile]
+    throw new Error('provider temporarily unavailable')
+  })
+  assert.equal(await registry.launch(windows, choice, verify, signal), undefined)
+  assert.equal(resolveCalls, 0, 'the user profile service cannot choose this explicit Windows launch')
+  assert.equal(await selectNativeUserShell(choice, () => awaitThen([nativeShell]), () => awaitThen(nativeShell)), nativeShell)
+  assert.equal(await registry.mayRememberNativeShell(wsl, signal), false)
+  assert.equal(await registry.mayRememberNativeShell(windows, signal), false)
+  dispose()
+  assert.equal(await registry.mayRememberNativeShell(windows, signal), true)
+})
+
+test('an unresponsive provider cannot block a Windows preference acknowledgement indefinitely', async () => {
+  const registry = new UserTerminalProfiles()
+  const stalled = Promise.withResolvers<readonly UserTerminalProfile[]>()
+  registry.register('dsh-wsl-env', () => stalled.promise)
+  // AbortSignal.timeout is unref'd, while a live terminal host has its own real handles.
+  const keepAlive = setTimeout(() => {}, 1000)
+  try {
+    assert.equal(await registry.mayRememberNativeShell(windows, signal), false)
+  } finally {
+    stalled.resolve([])
+    clearTimeout(keepAlive)
+  }
+})
+
+test('a remembered native hint can go stale, but explicit native and profile requests do not fall back', async () => {
+  const stale = userTerminalChoice({ preferredShellPath: 'missing' })
+  if (stale.kind !== 'default') throw new Error('Expected implicit choice')
+  assert.equal(await selectNativeUserShell(stale, () => awaitThen([nativeShell]), () => awaitThen(nativeShell)), nativeShell)
+  await assert.rejects(selectNativeUserShell({ kind: 'native', path: 'missing' }, () => awaitThen([nativeShell]), () => awaitThen(nativeShell)), /Selected shell is not available/u)
+  for (const ambiguous of [
+    { shellPath: nativePath, profileId }, { shellPath: nativePath, preferredShellPath: nativePath },
+    { profileId, preferredShellPath: nativePath },
+  ]) assert.throws(() => userTerminalChoice(ambiguous), /Specify only one/u)
+})
+
+test('providers cannot collide, leave stale launches active, or claim another namespace', async () => {
+  const registry = new UserTerminalProfiles()
+  const dispose = registry.register('dsh-wsl-env', () => [profile])
+  assert.throws(() => registry.register('dsh-wsl-env', () => []), /already registered/u)
+  const launch = await registry.launch(wsl, userTerminalChoice({ profileId }), verify, signal)
+  assert.ok(launch && !launch.signal.aborted)
+  dispose()
+  assert.equal(launch.signal.aborted, true)
+  await assert.rejects(registry.launch(wsl, userTerminalChoice({ profileId }), verify, signal), UserTerminalProfileUnavailableError)
+  registry.register('other', () => [profile])
+  await assert.rejects(registry.shells(wsl, verify, signal), /must be namespaced/u)
+})
+
+test('Agent shell selection is wired to stock discovery, not the user profile catalog or defaults', async () => {
+  const controller = readFileSync(new URL('../../src/index.ts', import.meta.url), 'utf8')
+  const agentShell = controller.slice(controller.indexOf('  private async agentShell('), controller.indexOf('  private async confine('))
+  assert.ok(agentShell.includes('this.nativeShells(agent, signal)'))
+  assert.doesNotMatch(agentShell, /this\.(?:shells|userProfiles)\b/u)
+  const subprocess = {
+    terminalEnvironment: async () => ({ platform: 'windows', defaultShell: 'cmd.exe' }),
+    resolveExecutable: async (path: string) => path === 'cmd.exe' ? nativePath : absent(),
+  } as unknown as SubprocessRuntime
+  const registry = new UserTerminalProfiles()
+  registry.register('dsh-wsl-env', () => [profile])
+  assert.equal((await registry.shells(wsl, verify, signal))[0]?.sessionDefault, true)
+  const available = await discoverShells(subprocess, undefined, ['powershell'], signal)
+  assert.equal(findShell(available, 'wsl'), undefined)
+  assert.equal((await resolveShell(subprocess, undefined, signal)).path, nativePath)
+})
