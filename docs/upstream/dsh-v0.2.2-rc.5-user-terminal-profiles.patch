@@ -0,0 +1,246 @@
+/** Host-owned launch profiles for the user's terminal, never for Agent terminals. */
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { SubprocessRuntime } from '@deepseek-ai/dsh-subprocess'
+import type { TerminalCreateRequest, TerminalShell } from './types.ts'
+
+/** A trusted, host-side launch declaration. Neither directory is accepted from a Remote request. */
+export interface UserTerminalProfileLaunch {
+  readonly path: string
+  readonly args: readonly string[]
+  /** Directory passed to the subprocess provider in its own path vocabulary. */
+  readonly hostCwd: string
+  /** Initial directory displayed in the terminal, which may be in a guest environment. */
+  readonly displayCwd: string
+}
+
+/** A per-Session contribution. Unavailable defaults stay visible and cannot silently launch another shell. */
+export type UserTerminalProfile = {
+  readonly id: string
+  readonly name: string
+  readonly preferred?: boolean
+} & (
+  | { readonly launch: UserTerminalProfileLaunch; readonly unavailableReason?: never }
+  | { readonly launch?: never; readonly unavailableReason: string }
+)
+
+export type UserTerminalProfileResolver = (
+  agent: Agent, signal: AbortSignal,
+) => readonly UserTerminalProfile[] | Promise<readonly UserTerminalProfile[]>
+
+type UserTerminalRequestChoice = Pick<TerminalCreateRequest, 'shellPath' | 'profileId' | 'preferredShellPath'>
+
+export type UserTerminalChoice =
+  | { readonly kind: 'native'; readonly path: string }
+  | { readonly kind: 'profile'; readonly id: string }
+  | { readonly kind: 'default'; readonly preferredNativePath: string | undefined }
+
+/** Keep an explicit choice distinct from a remembered path that may no longer be available. */
+export function userTerminalChoice(request: UserTerminalRequestChoice): UserTerminalChoice {
+  const { shellPath, profileId, preferredShellPath } = request
+  if ([shellPath, profileId, preferredShellPath].filter(value => value !== undefined).length > 1) {
+    throw new Error('Specify only one terminal shell choice')
+  }
+  if (profileId !== undefined) return { kind: 'profile', id: profileId }
+  if (shellPath !== undefined) return { kind: 'native', path: shellPath }
+  return { kind: 'default', preferredNativePath: preferredShellPath }
+}
+
+/** Resolve only verified native shells. A stale implicit hint never behaves like an explicit selection. */
+export async function selectNativeUserShell(
+  choice: Exclude<UserTerminalChoice, { kind: 'profile' }>,
+  discover: () => Promise<readonly TerminalShell[]>,
+  resolveDefault: () => Promise<TerminalShell>,
+): Promise<TerminalShell> {
+  if (choice.kind === 'native') {
+    const shell = (await discover()).find(candidate => candidate.path === choice.path)
+    if (shell === undefined) throw new Error('Selected shell is not available in this execution environment')
+    return shell
+  }
+  if (choice.preferredNativePath !== undefined) {
+    const shells = await discover()
+    const preferred = shells.find(candidate => candidate.path === choice.preferredNativePath)
+    if (preferred !== undefined) return preferred
+    if (shells[0] !== undefined) return shells[0]
+  }
+  return resolveDefault()
+}
+
+interface Registration {
+  readonly resolve: UserTerminalProfileResolver
+  readonly lifetime: AbortController
+}
+
+interface ResolvedProfile {
+  readonly profile: UserTerminalProfile
+  readonly signal: AbortSignal
+}
+
+export interface PreparedUserTerminalProfile {
+  readonly shell: TerminalShell
+  readonly hostCwd: string
+  readonly displayCwd: string
+  readonly signal: AbortSignal
+}
+
+export class UserTerminalProfileUnavailableError extends Error {
+  override readonly name = 'UserTerminalProfileUnavailableError'
+  readonly profileId: string
+
+  constructor(profileId: string, message: string) {
+    super(message)
+    this.profileId = profileId
+  }
+}
+
+const OWNER = /^[a-z][a-z0-9_-]{0,63}$/u
+const PROFILE_ID = /^[a-z][a-z0-9_.-]{0,127}$/u
+const EXECUTABLE_UNAVAILABLE = 'The terminal profile executable is no longer available'
+const NATIVE_PREFERENCE_PROBE_MS = 250
+
+function nonempty(value: unknown): value is string {
+  return typeof value === 'string' && value.trim() !== '' && !value.includes('\u0000')
+}
+
+/** Capture a value per request so mutable provider output cannot change already selected arguments. */
+function snapshotProfile(owner: string, profile: UserTerminalProfile): UserTerminalProfile {
+  if (!PROFILE_ID.test(profile.id) || !profile.id.startsWith(`${owner}.`) || profile.id.length === owner.length + 1) {
+    throw new Error(`User terminal profile IDs must be namespaced under ${owner}.`)
+  }
+  if (!nonempty(profile.name) || profile.name.length > 120) throw new Error('Terminal profile name must contain 1–120 characters')
+  const { id, preferred, launch, unavailableReason } = profile
+  const named = { id, name: profile.name.trim(), ...(preferred === true ? { preferred: true } : {}) }
+  if (launch === undefined) {
+    if (!nonempty(unavailableReason)) throw new Error(`Terminal profile ${id} must declare a launch or an unavailable reason`)
+    return { ...named, unavailableReason }
+  }
+  if (unavailableReason !== undefined || !nonempty(launch.path) || !nonempty(launch.hostCwd) || !nonempty(launch.displayCwd)
+    || !Array.isArray(launch.args) || [...launch.args].some(arg => typeof arg !== 'string' || arg.includes('\u0000'))) {
+    throw new Error(`Invalid launch for terminal profile ${id}`)
+  }
+  return { ...named, launch: { path: launch.path, args: [...launch.args], hostCwd: launch.hostCwd, displayCwd: launch.displayCwd } }
+}
+
+function unavailableShell(profile: UserTerminalProfile, reason: string): TerminalShell {
+  return { ...shellMetadata(profile), path: '', args: [], unavailableReason: reason }
+}
+
+function shellMetadata(profile: UserTerminalProfile) {
+  return { name: profile.name, profileId: profile.id, ...(profile.preferred ? { sessionDefault: true } : {}) }
+}
+
+function missingExecutable(error: unknown): boolean {
+  return typeof error === 'object' && error !== null && 'name' in error && error.name === 'SubprocessExecutableNotFoundError'
+}
+
+/** Resolves contributions only against the exact Agent passed by the user-terminal controller. */
+export class UserTerminalProfiles {
+  private readonly registrations = new Map<string, Registration>()
+
+  register(owner: string, resolve: UserTerminalProfileResolver): () => void {
+    if (!OWNER.test(owner) || typeof resolve !== 'function') throw new Error('Invalid user terminal profile provider')
+    if (this.registrations.has(owner)) throw new Error(`User terminal profile provider ${owner} is already registered`)
+    const registration = { resolve, lifetime: new AbortController() }
+    this.registrations.set(owner, registration)
+    return () => {
+      if (this.registrations.get(owner) === registration) this.registrations.delete(owner)
+      registration.lifetime.abort()
+    }
+  }
+
+  dispose(): void {
+    for (const registration of this.registrations.values()) registration.lifetime.abort()
+    this.registrations.clear()
+  }
+
+  private async resolve(agent: Agent, request: AbortSignal): Promise<ResolvedProfile[]> {
+    request.throwIfAborted()
+    const registrations = [...this.registrations]
+    const candidates = (await Promise.all(registrations.map(async ([owner, registration]) => {
+      const signal = AbortSignal.any([request, registration.lifetime.signal])
+      signal.throwIfAborted()
+      const profiles = await registration.resolve(agent, signal)
+      signal.throwIfAborted()
+      if (!Array.isArray(profiles)) throw new Error(`Invalid terminal profiles from ${owner}`)
+      return profiles.map((profile: UserTerminalProfile) => ({ profile: snapshotProfile(owner, profile), signal }))
+    }))).flat()
+    request.throwIfAborted()
+    const ids = new Set<string>()
+    let preferred = false
+    for (const { profile, signal } of candidates) {
+      signal.throwIfAborted()
+      if (ids.has(profile.id)) throw new Error(`Duplicate user terminal profile ${profile.id}`)
+      ids.add(profile.id)
+      if (profile.preferred) {
+        if (preferred) throw new Error('This Session has more than one default user terminal profile')
+        preferred = true
+      }
+    }
+    return candidates
+  }
+
+  /** An optional acknowledgement must not make explicitly chosen native shells depend on a plugin. */
+  async mayRememberNativeShell(agent: Agent, request: AbortSignal): Promise<boolean> {
+    if (request.aborted) return false
+    if (this.registrations.size === 0) return true
+    const signal = AbortSignal.any([request, AbortSignal.timeout(NATIVE_PREFERENCE_PROBE_MS)])
+    return new Promise<boolean>(resolve => {
+      const onAbort = (): void => finish(false)
+      const finish = (result: boolean): void => {
+        signal.removeEventListener('abort', onAbort)
+        resolve(result)
+      }
+      signal.addEventListener('abort', onAbort, { once: true })
+      void this.resolve(agent, signal).then(
+        profiles => finish(!signal.aborted && !profiles.some(({ profile }) => profile.preferred)),
+        () => finish(false),
+      )
+    })
+  }
+
+  /** Additional choices, leaving a failed preferred profile disabled rather than removing it. */
+  async shells(agent: Agent, subprocess: Pick<SubprocessRuntime, 'resolveExecutable'>, signal: AbortSignal): Promise<TerminalShell[]> {
+    const candidates = await this.resolve(agent, signal)
+    const shells = await Promise.all(candidates.map(async ({ profile, signal: scoped }) => {
+      scoped.throwIfAborted()
+      if (profile.launch === undefined) return unavailableShell(profile, profile.unavailableReason)
+      try {
+        const path = await subprocess.resolveExecutable(profile.launch.path, undefined, scoped)
+        scoped.throwIfAborted()
+        return { ...shellMetadata(profile), path, args: profile.launch.args }
+      } catch (error) {
+        scoped.throwIfAborted()
+        if (!missingExecutable(error)) throw error
+        return unavailableShell(profile, EXECUTABLE_UNAVAILABLE)
+      }
+    }))
+    signal.throwIfAborted()
+    for (const candidate of candidates) candidate.signal.throwIfAborted()
+    return shells
+  }
+
+  /** Re-resolve the selected profile at create time; a failed explicit or default profile never falls back. */
+  async launch(
+    agent: Agent, choice: UserTerminalChoice, subprocess: Pick<SubprocessRuntime, 'resolveExecutable'>, request: AbortSignal,
+  ): Promise<PreparedUserTerminalProfile | undefined> {
+    if (choice.kind === 'native') return undefined
+    const candidates = await this.resolve(agent, request)
+    const selected = candidates.find(({ profile }) => choice.kind === 'profile' ? profile.id === choice.id : profile.preferred)
+    if (selected === undefined) {
+      if (choice.kind === 'profile') throw new UserTerminalProfileUnavailableError(choice.id, 'The selected terminal profile is not available in this Session')
+      return undefined
+    }
+    const { profile, signal } = selected
+    signal.throwIfAborted()
+    const { launch } = profile
+    if (launch === undefined) throw new UserTerminalProfileUnavailableError(profile.id, profile.unavailableReason)
+    try {
+      const path = await subprocess.resolveExecutable(launch.path, undefined, signal)
+      signal.throwIfAborted()
+      return { shell: { ...shellMetadata(profile), path, args: launch.args }, hostCwd: launch.hostCwd, displayCwd: launch.displayCwd, signal }
+    } catch (error) {
+      signal.throwIfAborted()
+      if (!missingExecutable(error)) throw error
+      throw new UserTerminalProfileUnavailableError(profile.id, EXECUTABLE_UNAVAILABLE)
+    }
+  }
+}
